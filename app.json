{
  "expo": {
    "name": "Tjat",
    "slug": "tjat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.josefanderberg.tjat",
      "appleTeamId": "66D54NKWK7",
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Tjat lyssnar på din inspelning för att ge tjatet en titel. Det sker bara i telefonen.",
        "NSPhotoLibraryUsageDescription": "Tjat använder inte ditt bildbibliotek. Bevisbilderna sparas bara i appen.",
        "NSPhotoLibraryAddUsageDescription": "Tjat använder inte ditt bildbibliotek. Bevisbilderna sparas bara i appen."
      }
    },
    "android": {
      "package": "com.josefanderberg.tjat",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Tjat behöver mikrofonen för att spela in ditt tjat med din egen röst."
        }
      ],
      "expo-notifications",
      "expo-asset",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Klar",
            "ios": "./assets/icon-klar.png",
            "android": {
              "foregroundImage": "./assets/icon-klar-foreground.png",
              "backgroundColor": "#2e9e5b"
            }
          }
        ]
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Tjat tar en bild med frontkameran när du snoozar eller klarar ett tjat, men bara om du har slagit på kameran.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Tjat känner av om du plockar upp mobilen när vakten är på, så att den kan larma."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "11561a56-4cf8-4d7d-974a-560ba0de919d"
      }
    },
    "owner": "josefanderberg"
  }
}
