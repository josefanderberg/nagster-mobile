{
  "expo": {
    "name": "Tjat",
    "slug": "tjat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.josefanderberg.tjat",
      "infoPlist": {
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true },
        "NSLocalNetworkUsageDescription": "Tjat pratar med din server på hemmanätet för att spara tjat och inspelningar."
      }
    },
    "android": {
      "package": "com.josefanderberg.tjat",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Tjat behöver mikrofonen för att spela in ditt tjat med din egen röst."
        }
      ],
      "expo-notifications"
    ]
  }
}
